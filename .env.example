# Copy to .env (or run `make init-env`, which does it AND generates every secret).
# Values equal to CHANGE_ME are secrets: `python3 scripts/init_env.py` replaces each
# one with a fresh random value. Never commit the real .env file.
#
# Host-side tools (generator, consumer, dbt run from your laptop) use the
# localhost values below. Containers get their internal hostnames from
# infra/docker-compose.yml, so these localhost values never leak into them.

# ---- Warehouse Postgres (schemas: raw / staging / curated) ----
POSTGRES_USER=telecom_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=telecom_dwh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Airflow metadata Postgres ----
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_DB_NAME=airflow

# ---- Airflow core ----
# Fernet key: url-safe base64 of 32 random bytes (generated by init_env.py)
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME

# ---- Source Postgres (OLTP-style table the generator writes into; CDC source) ----
SOURCE_POSTGRES_USER=source_app
SOURCE_POSTGRES_PASSWORD=CHANGE_ME
SOURCE_POSTGRES_DB=telecom_source
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5433

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Debezium topic convention: <topic.prefix>.<schema>.<table>
# (see infra/kafka-connect/postgres-source-connector.json)
KAFKA_TOPIC_NETWORK_EVENTS=telecom.source.network_events
# KRaft cluster id: url-safe base64 of a UUID, 22 chars, no padding (generated by init_env.py)
KAFKA_CLUSTER_ID=CHANGE_ME

# ---- Kafka Connect (Debezium PostgreSQL source connector) ----
KAFKA_CONNECT_URL=http://localhost:8083

# ---- Spark (batch aggregation) ----
SPARK_MASTER_URL=spark://localhost:7077

# ---- RustFS (S3-compatible object storage, raw landing zone) ----
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_RAW_BUCKET=raw-network-events

# ---- Synthetic data generator ----
GENERATOR_EVENTS_PER_SECOND=5
# fraction of events with a deliberately broken field
GENERATOR_DIRTY_RECORD_RATE=0.05
# fraction of events carrying an undocumented extra attribute (schema drift)
GENERATOR_SCHEMA_DRIFT_RATE=0.02
GENERATOR_SUBSCRIBER_POOL_SIZE=2000
GENERATOR_CELL_COUNT=60
# fixed seed -> the same subscriber/cell population on every run
GENERATOR_SEED=42
